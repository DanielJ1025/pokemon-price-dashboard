# 포켓몬 카드 매물 감시 — 자격증명 템플릿
# 이 파일을 워크스페이스 루트(D:\00_AI_DEV\00_CLAUDE)의 .env 로 복사한 뒤 값 채우기.
# .env 는 .gitignore 로 커밋되지 않음(절대 실키를 여기 example 에 넣지 말 것).

# ── 네이버 검색 OpenAPI (지마켓·옥션·11번가·스마트스토어 등 정식몰 통합) ──
# 발급: https://developers.naver.com/apps → 애플리케이션 등록 → "검색" API 추가
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 쿠팡 파트너스 (선택 — 쿠팡 매물. 없으면 쿠팡만 건너뜀) ──
# 발급: https://partners.coupang.com 가입 → 승인 후 API 키. 로켓배송 재고는 제한적.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# ── 번개장터 (중고) 는 무인증 — 키 필요 없음, 항상 켜짐 ──

# ── 텔레그램 봇 (알림 발송) ──
# 봇 생성: 텔레그램에서 @BotFather → /newbot → 토큰 복사
TELEGRAM_BOT_TOKEN=
# chat_id 확인: 봇에게 아무 메시지나 먼저 보낸 뒤
#   python 90_SYSTEM/automation/pokemon_deal_watch.py --chat-id
TELEGRAM_CHAT_ID=

# ── 11번가 오픈API (선택 — 실판매 상품 직접조회, 재고 정확) ──
# 발급: https://openapi.11st.co.kr 회원가입 → 인증키 발급(무료·180일)
OPEN_API_11ST_KEY=
